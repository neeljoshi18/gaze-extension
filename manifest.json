{
  "manifest_version": 3,
  "name": "Gaze — Scroll Reels with your eyes",
  "version": "1.0.2",
  "description": "On Instagram Reels, open your camera and scroll with your face and eyes.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gaze",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tracker.html",
        "tracker.js",
        "mediapipe/*"
      ],
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-gaze": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Toggle Gaze"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
